{
  "manifest_version": 3,
  "name": "MD Editor",
  "version": "1.5.28",
  "description": "A powerful Markdown editor with Mermaid & LaTeX support",
  "permissions": ["storage"],
  "action": {
    "default_title": "Open MD Editor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}